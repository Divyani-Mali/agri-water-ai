DATABASE_URL=sqlite:///./agri.db
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SENSOR_API_KEY=replace-with-a-random-secret
FRONTEND_URL=http://127.0.0.1:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# Local development only: return the reset link in the API response when SMTP is not configured.
PASSWORD_RESET_DEV_MODE=false

# ------------------------------------------------------------------ Speech-to-Text (STT)
# Supported values:
#   mock            — no credentials needed; always returns a canned transcript.
#                     Use this for local development and CI.
#   openai_whisper  — calls the OpenAI Whisper API (whisper-1 model).
#                     Requires OPENAI_API_KEY.
STT_PROVIDER=mock

# Required when STT_PROVIDER=openai_whisper
OPENAI_API_KEY=

# Maximum audio upload size in megabytes (default: 10)
AUDIO_MAX_MB=10

# Maximum audio duration in seconds (default: 120)
AUDIO_MAX_SECONDS=120

# Directory for temporary audio files.
# Leave empty to use the system temp directory.
AUDIO_TEMP_DIR=

# Minutes after which unclaimed temp audio files are removed (default: 10)
AUDIO_RETENTION_MINUTES=10

# ------------------------------------------------------------------ Text-to-Speech (TTS)
# Supported values:
#   mock    — no credentials needed; returns a silent WAV.
#             Use this for local development and CI.
#   openai  — calls the OpenAI TTS API (tts-1 model, alloy voice).
#             Reuses OPENAI_API_KEY.  Supports en, hi, mr.
#   google  — calls Google Cloud Text-to-Speech.
#             Requires GOOGLE_APPLICATION_CREDENTIALS.
TTS_PROVIDER=mock

# Required when TTS_PROVIDER=openai  (same key as STT)
# OPENAI_API_KEY is already listed above under STT — no need to repeat it.

# Required when TTS_PROVIDER=google
# Path to a Google Cloud service-account JSON key file.
# Leave empty to use Application Default Credentials (ADC) instead.
GOOGLE_APPLICATION_CREDENTIALS=

# Maximum characters accepted as TTS input (default: 1000)
TTS_MAX_CHARS=1000

# Output audio format for TTS: "mp3" (default, works for all real providers)
# or "wav" (mock provider only)
TTS_AUDIO_FORMAT=mp3
